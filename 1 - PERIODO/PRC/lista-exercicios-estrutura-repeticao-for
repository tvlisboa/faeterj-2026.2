	    printf("Exercicio - 8 - Numeros primos \n");
	    printf("Informe um numero a seguir: ");
	    scanf("%d" , &numero);

	    do {

	       if(numero % contador == 0){
		    contDiv++;

	       }

	       contador++;

	    } while (contador<=numero);

		if(contDiv == 2){

		    printf("O numero %d , e primo \n" , numero);

